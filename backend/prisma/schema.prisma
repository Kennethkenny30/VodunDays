generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, postgis, uuid_ossp(map: "uuid-ossp")]
}

// Ajout de l'enum
enum MarkerCategory {
  SITE
  TOILETTES
  URGENCES
  TRANSPORT
  ASSISTANCE
  PRA
}

model Sites {
  id          String          @id @default(uuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  type        String          // sous-type libre : "Scène", "Navette", "PRA-Plage"...
  category    MarkerCategory  @default(SITE)  
  capacity    Int             @default(0)

  arLabel     String?         // texte affiché en AR
  arContent   String?         // URL vidéo/image ou contenu JSON AR
  arRadius    Float?          // rayon de détection en mètres
  zoneGeo     Unsupported("geometry")?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  alerts      Alerts[]
  amenities   Amenities[]
  events      Events[]

  @@index([category])         // filtrage map rapide
}

model Amenities {
  id        String   @id @default(uuid())
  name      String
  siteId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Sites    @relation(fields: [siteId], references: [id])
}

model EventsTypes {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Events[]
}

model Events {
  id          String      @id @default(uuid())
  name        String
  description String?
  status      String
  siteId      String
  eventTypeId String
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  imageUrl    String?
  artists     Artists[]
  eventType   EventsTypes @relation(fields: [eventTypeId], references: [id])
  site        Sites       @relation(fields: [siteId], references: [id])
  programs    Programs[]
  quizzes     Quiz[]
}

model Programs {
  id        String   @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Events   @relation(fields: [eventId], references: [id])
}

model Artists {
  id        String   @id @default(uuid())
  name      String
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Events   @relation(fields: [eventId], references: [id])
}

model Quiz {
  id          String      @id @default(uuid())
  title       String
  description String?
  active      Boolean     @default(false)
  eventId     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  questions   Questions[]
  event       Events      @relation(fields: [eventId], references: [id])
}

model QuestionsTypes {
  id        String      @id @default(uuid())
  types     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  questions Questions[]
}

model Questions {
  id             String                  @id @default(uuid())
  wording        String
  questionTypeId String
  quizId         String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  answers        Answers[]
  choices        Choices[]
  questionType   QuestionsTypes          @relation(fields: [questionTypeId], references: [id])
  quiz           Quiz                    @relation(fields: [quizId], references: [id])
  impressions    Questions_impressions[]
}

model Impressions {
  id        String                  @id @default(uuid())
  name      String
  emoji     String
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  questions Questions_impressions[]
}

model Questions_impressions {
  questionId   String
  impressionId String
  impression   Impressions @relation(fields: [impressionId], references: [id])
  question     Questions   @relation(fields: [questionId], references: [id])

  @@id([questionId, impressionId])
}

model Choices {
  id         String    @id @default(uuid())
  wording    String
  questionId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  question   Questions @relation(fields: [questionId], references: [id])
}

model Answers {
  id         String    @id @default(uuid())
  // uuid festivalier pour déduplication - non-unique car plusieurs réponses d'un même festivalier
  uuid       String?
  response   String
  questionId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  question   Questions @relation(fields: [questionId], references: [id])
}

model Users {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  role           String
  active         Boolean         @default(true)
  firstname      String
  lastname       String
  phone          String?
  lastLoging     DateTime?
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  alertTimelines AlertTimeline[]
}

model Notifications {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  message     String
  target      String    @default("ALL")
  targetId    String?
  status      String    @default("PENDING")
  scheduledAt DateTime? @db.Timestamptz(6)
  sentAt      DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status], map: "idx_notifications_status")
}

model Alerts {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uuid        String
  displayName String
  type        String
  description String
  status      String          @default("OPEN")
  siteId      String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  timeline    AlertTimeline[]
  site        Sites?          @relation(fields: [siteId], references: [id], onUpdate: NoAction)

  @@index([status], map: "idx_alerts_status")
  @@index([type], map: "idx_alerts_type")
  @@index([uuid], map: "idx_alerts_uuid")
}

model AlertTimeline {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alertId   String   @db.Uuid
  status    String
  note      String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  alert     Alerts   @relation(fields: [alertId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      Users?   @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([alertId], map: "idx_timeline_alert")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AuditLogs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action      String
  module      String
  description String
  metadata    Json?
  userId      String?   @db.Uuid
  userName    String?
  ipAddress   String?
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([module])
}
